---
const pillars = [
  {
    title: 'Misión',
    detail:
      'Desarrollar soluciones tecnológicas que optimicen procesos y generen valor a la comunidad estudiantil y externa.'
  },
  {
    title: 'Visión',
    detail:
      'Posicionarnos como referente universitario en transformación digital, con excelencia técnica y colaborativa.'
  },
  {
    title: 'Propósito',
    detail:
      'Impulsar inserción laboral mediante practica real en entornos de desarrollo, analítica y liderazgo tecnológico.'
  }
];
---

<section id="sobre-nosotros" class="section-wrap py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="kicker" data-animate>Quienes Somos</p>
      <h2 class="section-title mt-5 text-3xl text-ieee-dark sm:text-4xl" data-animate>
        Lideramos la transformación digital desde la universidad.
      </h2>
      <p class="mt-5 text-base leading-relaxed text-slate-600 sm:text-lg" data-animate>
        Somos el motor de cambio tecnologico de IEEE UTP. Articulamos talento en Desarrollo e Innovación e Impacto Tech para construir soluciones funcionales, medibles y sostenibles.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        pillars.map((item, idx) => (
          <article class="card-panel lift-hover rounded-2xl p-7" data-animate="zoom" class:list={[`stagger-${idx + 1}`]}>
            <span class="chip">{`0${idx + 1}`}</span>
            <h3 class="mt-4 text-xl font-extrabold text-ieee-dark">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>