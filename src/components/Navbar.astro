---
import logoIEEE from '../assets/IEEE_Logo.png';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-transform duration-300 ease-in-out"
>
  <div class="w-full">
    <div
      id="nav-shell"
      class="w-full border-b border-white/10 bg-ieee-dark/95 shadow-2xl shadow-black/20 backdrop-blur-md"
    >
      <div
        class="mx-auto flex h-22 w-full max-w-7xl items-center justify-between px-4 sm:px-6 md:h-23 lg:px-8"
      >
        <a href="#inicio" class="focusable block" aria-label="Ir al inicio">
          <img
            src={logoIEEE.src}
            alt="Logo Universidad Tecnologica del Peru - IEEE Student Branch"
            class="h-17 mt-1 w-auto object-contain drop-shadow-md sm:h-17"
          />
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Navegacion principal">
          <a
            href="#inicio"
            class="focusable rounded-lg px-4 py-2 text-sm font-semibold text-blue-100/90 transition-all duration-300 hover:-translate-y-px hover:bg-white/10 hover:text-white"
            >Inicio</a
          >

          <a
            href="#sobre-nosotros"
            class="focusable rounded-lg px-4 py-2 text-sm font-semibold text-blue-100/90 transition-all duration-300 hover:-translate-y-px hover:bg-white/10 hover:text-white"
            >Nosotros</a
          >

          <a
            href="#areas"
            class="focusable rounded-lg px-4 py-2 text-sm font-semibold text-blue-100/90 transition-all duration-300 hover:-translate-y-px hover:bg-white/10 hover:text-white"
            >Areas</a
          >

          <a
            href="#equipo"
            class="focusable rounded-lg px-4 py-2 text-sm font-semibold text-blue-100/90 transition-all duration-300 hover:-translate-y-px hover:bg-white/10 hover:text-white"
            >Equipo</a
          >

          <a
            href="#eventos"
            class="focusable rounded-lg px-4 py-2 text-sm font-semibold text-blue-100/90 transition-all duration-300 hover:-translate-y-px hover:bg-white/10 hover:text-white"
            >Eventos</a
          >

          <a
            href="#contacto"
            class="focusable rounded-lg px-4 py-2 text-sm font-semibold text-blue-100/90 transition-all duration-300 hover:-translate-y-px hover:bg-white/10 hover:text-white"
            >Únete</a
          >
        </nav>

        <button
          id="mobile-menu-btn"
          class="focusable inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/10 p-2 text-white transition-colors hover:bg-white/16 md:hidden"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="mx-3 mt-3 max-h-0 origin-top overflow-hidden rounded-2xl border border-white/10 bg-ieee-dark/95 p-0 opacity-0 shadow-xl backdrop-blur-md transition-all duration-300 ease-out md:hidden"
    >
      <nav class="flex flex-col gap-1.5" aria-label="Navegacion movil">
        <a
          href="#inicio"
          class="focusable rounded-lg px-3 py-2.5 text-sm font-medium text-blue-100/90 transition-colors hover:bg-white/12"
          >Inicio</a
        >

        <a
          href="#sobre-nosotros"
          class="focusable rounded-lg px-3 py-2.5 text-sm font-medium text-blue-100/90 transition-colors hover:bg-white/12"
          >Nosotros</a
        >

        <a
          href="#areas"
          class="focusable rounded-lg px-3 py-2.5 text-sm font-medium text-blue-100/90 transition-colors hover:bg-white/12"
          >Areas</a
        >

        <a
          href="#equipo"
          class="focusable rounded-lg px-3 py-2.5 text-sm font-medium text-blue-100/90 transition-colors hover:bg-white/12"
          >Equipo</a
        >

        <a
          href="#eventos"
          class="focusable rounded-lg px-3 py-2.5 text-sm font-medium text-blue-100/90 transition-colors hover:bg-white/12"
          >Eventos</a
        >

        <a
          href="#contacto"
          class="focusable rounded-lg px-3 py-2.5 text-sm font-medium text-blue-100/90 transition-colors hover:bg-white/12"
          >Unete</a
        >
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  const toggleMobileMenu = (open: boolean) => {
    if (!btn || !menu) return;

    btn.setAttribute('aria-expanded', String(open));

    if (open) {
      menu.classList.remove('max-h-0', 'opacity-0', 'p-0');
      menu.classList.add('max-h-96', 'opacity-100', 'p-3');
    } else {
      menu.classList.remove('max-h-96', 'opacity-100', 'p-3');
      menu.classList.add('max-h-0', 'opacity-0', 'p-0');
    }
  };

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      toggleMobileMenu(!expanded);
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMobileMenu(false);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      toggleMobileMenu(false);
    });
  }
</script>

<script>
  const header = document.getElementById('site-header');

  let lastScrollY = window.scrollY;
  let scrollUpDistance = 0;

  const HIDE_AFTER = 85;
  const SHOW_AFTER = 40;

  window.addEventListener(
    'scroll',
    () => {
      if (!header) return;

      const currentScrollY = window.scrollY;
      const difference = currentScrollY - lastScrollY;

      const atBottom =
        window.innerHeight + currentScrollY >= document.documentElement.scrollHeight - 10;

      if (atBottom) {
        header.classList.add('-translate-y-full');
        scrollUpDistance = 0;
        lastScrollY = currentScrollY;
        return;
      }

      if (difference > 0) {
        scrollUpDistance = 0;

        if (currentScrollY > HIDE_AFTER) {
          header.classList.add('-translate-y-full');
        }
      }

      else if (difference < 0) {
        scrollUpDistance += Math.abs(difference);

        if (scrollUpDistance >= SHOW_AFTER) {
          header.classList.remove('-translate-y-full');
          scrollUpDistance = 0;
        }
      }

      lastScrollY = currentScrollY;
    },
    { passive: true },
  );
</script>
